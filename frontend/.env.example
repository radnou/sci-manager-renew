# -----------------------------------------------------------------------------
# Analytics — at least one provider must be configured in production.
# Leave all empty to disable analytics (recommended for dev).
# -----------------------------------------------------------------------------

# Plausible Analytics (recommended, cookieless, GDPR-friendly)
# VITE_PLAUSIBLE_DOMAIN=gerersci.fr
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# VITE_PLAUSIBLE_API_HOST=                # set when self-hosting Plausible

# Matomo (legacy, kept as optional fallback during the Plausible migration)
# VITE_MATOMO_URL=https://analytics.example.com
# VITE_MATOMO_SITE_ID=1

# Set to 'false' only if every active provider is confirmed cookieless.
# Default 'true' keeps the existing consent flow.
# VITE_ANALYTICS_REQUIRE_CONSENT=true

# ============================================================
# GererSCI — Production Environment Variables
# ============================================================
# Copy this file: cp .env.production.example .env
# Then fill in ALL values marked with <CHANGE_ME>

# ---- Application ----
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=json

# ---- URLs ----
FRONTEND_URL=https://app.gerersci.fr
VITE_API_URL=https://api.gerersci.fr
CORS_ORIGINS=["https://app.gerersci.fr","https://gerersci.fr","https://www.gerersci.fr"]
ALLOWED_HOSTS=gerersci.fr,*.gerersci.fr

# ---- Supabase ----
SUPABASE_URL=<CHANGE_ME>
SUPABASE_PUBLIC_URL=https://api.gerersci.fr
SUPABASE_ANON_KEY=<CHANGE_ME>
SUPABASE_SERVICE_ROLE_KEY=<CHANGE_ME>
SUPABASE_JWT_SECRET=<CHANGE_ME>

# ---- Stripe ----
# PRODUCTION (paiements reels) = cles LIVE (sk_live_/pk_live_) + price IDs crees en mode LIVE.
# PRE-REQUIS: compte Stripe ACTIVE (Dashboard > Activer le compte: societe + IBAN + identite).
# Tant que charges_enabled=false, aucun paiement live n'est possible. Voir docs/STRIPE_GOLIVE.md.
STRIPE_SECRET_KEY=<CHANGE_ME_sk_live_...>
STRIPE_PUBLISHABLE_KEY=<CHANGE_ME_pk_live_...>
# Signing secret de l'endpoint webhook qui pointe vers https://api.gerersci.fr/api/v1/stripe/webhook
# (Dashboard > Developers > Webhooks > [endpoint] > Signing secret). DOIT etre du meme mode (live) que les cles.
STRIPE_WEBHOOK_SECRET=<CHANGE_ME_whsec_...>

# --- Catalogue actuel: Gestion / Pilotage / Fondateur (noms utilises en PRIORITE par le backend) ---
STRIPE_GESTION_MONTHLY_PRICE_ID=<CHANGE_ME_price_...>   # Gestion 19EUR/mois
STRIPE_GESTION_ANNUAL_PRICE_ID=<CHANGE_ME_price_...>    # Gestion 190EUR/an
STRIPE_PILOTAGE_MONTHLY_PRICE_ID=<CHANGE_ME_price_...>  # Pilotage 39EUR/mois
STRIPE_PILOTAGE_ANNUAL_PRICE_ID=<CHANGE_ME_price_...>   # Pilotage 390EUR/an
STRIPE_FONDATEUR_PRICE_ID=<CHANGE_ME_price_...>         # Fondateur 349EUR (paiement unique)

# --- Alias herites (fallback si les vars ci-dessus sont vides). STARTER=Gestion, PRO=Pilotage. ---
STRIPE_STARTER_PRICE_ID=<CHANGE_ME_price_...>           # = GESTION_MONTHLY
STRIPE_STARTER_ANNUAL_PRICE_ID=<CHANGE_ME_price_...>    # = GESTION_ANNUAL
STRIPE_PRO_PRICE_ID=<CHANGE_ME_price_...>               # = PILOTAGE_MONTHLY
STRIPE_PRO_ANNUAL_PRICE_ID=<CHANGE_ME_price_...>        # = PILOTAGE_ANNUAL
STRIPE_LIFETIME_PRICE_ID=<CHANGE_ME_price_...>          # deprecie (grandfathered) = FONDATEUR
STRIPE_CABINET_PRICE_ID=<CHANGE_ME_price_...>           # Cabinet 79EUR/mois (optionnel)
STRIPE_CABINET_ANNUAL_PRICE_ID=<CHANGE_ME_price_...>    # Cabinet 790EUR/an (optionnel)

# Cle publique cote frontend (build arg). En general = STRIPE_PUBLISHABLE_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=<CHANGE_ME_pk_live_...>

# ---- Email (Resend) ----
RESEND_API_KEY=<CHANGE_ME_re_>
RESEND_FROM_EMAIL=noreply@gerersci.fr

# ---- Sentry ----
SENTRY_DSN=
VITE_SENTRY_DSN=

# ---- Feature Flags ----
FEATURE_PLAN_ENTITLEMENTS_ENFORCEMENT=enforce
PUBLIC_FEATURE_MULTI_SCI_DASHBOARD_V2=true

# ---- Matomo Analytics ----
VITE_MATOMO_URL=https://analytics.gerersci.fr
VITE_MATOMO_SITE_ID=1
MATOMO_DB_ROOT_PASSWORD=<CHANGE_ME>
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=<CHANGE_ME>

# ---- Grafana ----
# REQUIRED — compose will refuse to start without GRAFANA_ADMIN_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---- Staging overrides (optional) ----
# STAGING_SUPABASE_URL=
# STAGING_SUPABASE_ANON_KEY=
# STAGING_SUPABASE_SERVICE_ROLE_KEY=
# STAGING_SUPABASE_JWT_SECRET=
